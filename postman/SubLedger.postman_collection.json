          ]
        },
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List active plans only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans?active_only=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ],
              "query": [
                {
                  "key": "active_only",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"All active\", () => json.forEach(p => pm.expect(p.is_active).to.be.true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans/{{plan_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{plan_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update plan (description)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans/{{plan_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{plan_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Pro tier, updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Price can also be changed here. Existing invoices keep their snapshot price."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
