{
  "info": {
    "name": "SubLedger API",
    "description": "SubLedger SaaS subscription & billing backend.\n\nRun the whole collection in order with the Collection Runner: each request saves the ids the next ones need (plan_id, customer_id, subscription_id, invoice_id, payment_id). `run_id` is set per run so emails and references stay unique; no DB reset needed.\n\nSet `baseUrl` (default http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"run_id\") || pm.info.iteration === 0 && pm.info.requestName === \"Health check\") {",
          "  pm.collectionVariables.set(\"run_id\", Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "plan_id",
      "value": ""
    },
    {
      "key": "inactive_plan_id",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "customer_email",
      "value": ""
    },
    {
      "key": "subscription_id",
      "value": ""
    },
    {
      "key": "invoice_id",
      "value": ""
    },
    {
      "key": "invoice2_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "failed_payment_id",
      "value": ""
    },
    {
      "key": "remaining",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Create plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro Monthly\",\n  \"description\": \"Pro tier\",\n  \"price\": \"999.00\",\n  \"currency\": \"INR\",\n  \"billing_interval\": \"monthly\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"plan_id\", json.id);",
                  "pm.test(\"Price stored as money string\", () => pm.expect(json.price).to.eql(\"999.00\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create inactive plan",
          "request": {
            "method": "POST",
            "header": [
