            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Legacy\",\n  \"price\": \"199.00\",\n  \"currency\": \"INR\",\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"inactive_plan_id\", json.id);"
