    {
      "name": "Payments",
      "item": [
        {
          "name": "Partial payment (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"{{invoice_id}}\",\n  \"amount\": \"400.00\",\n  \"currency\": \"INR\",\n  \"status\": \"success\",\n  \"provider_reference\": \"pay_{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"payment_id\", json.payment_attempt.id);",
                  "pm.collectionVariables.set(\"remaining\", json.invoice.amount_remaining);",
                  "pm.test(\"partially_paid\", () => pm.expect(json.invoice.status).to.eql(\"partially_paid\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"{{invoice_id}}\",\n  \"amount\": \"599.00\",\n  \"currency\": \"INR\",\n  \"status\": \"failed\",\n  \"provider_reference\": \"pay_{{$guid}}\",\n  \"failure_reason\": \"card_declined\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"failed_payment_id\", json.payment_attempt.id);",
                  "pm.test(\"amount_paid unchanged\", () => pm.expect(json.invoice.amount_paid).to.eql(\"400.00\"));",
                  "pm.test(\"Reason stored\", () => pm.expect(json.payment_attempt.failure_reason).to.eql(\"card_declined\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay remaining (success)",
